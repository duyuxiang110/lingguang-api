[Unit]
Description=LingGuang Python API
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/lingguang-api
ExecStart=/opt/lingguang-api/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
Environment=HOME=/tmp/lingguang
MemoryMax=1.5G
OOMScoreAdjust=500
ExecStartPre=/bin/mkdir -p /tmp/lingguang/uploads /tmp/lingguang/work /tmp/lingguang/output
ExecStartPre=/bin/chown -R www-data:www-data /tmp/lingguang

[Install]
WantedBy=multi-user.target
